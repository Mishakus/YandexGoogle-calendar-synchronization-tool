#!/bin/bash
SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || (command -v realpath >/dev/null && realpath "$0") || echo "$0")
DIR=$(dirname "$SCRIPT_PATH")
CONFIG_FILE="$DIR/config.json"
cd "$DIR" || { echo "Ошибка: не могу найти директорию проекта $DIR"; exit 1; }

DOCKER_COMPOSE_CMD=""
if docker compose version > /dev/null 2>&1; then
    DOCKER_COMPOSE_CMD="docker compose"
elif command -v docker-compose > /dev/null 2>&1; then
    DOCKER_COMPOSE_CMD="docker-compose"
fi

if [ ! -f "$CONFIG_FILE" ]; then echo "{}" > "$CONFIG_FILE"; fi

install() {
    if [[ -z "$DOCKER_COMPOSE_CMD" ]]; then
        echo "ОШИБКА: Не найден Docker Compose!"
        echo "Пожалуйста, установите docker-compose перед продолжением."
        echo "Команда для установки:"
        echo 'sudo curl -L "https://github.com/docker/compose/releases/download/v2.24.5/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose && sudo chmod +x /usr/local/bin/docker-compose'
        exit 1
    fi

    sudo ln -sf "$SCRIPT_PATH" /usr/local/bin/ya-gcal-sync
    sudo chmod +x "$SCRIPT_PATH"
    $DOCKER_COMPOSE_CMD up -d --build
    echo "Установка завершена!"
}

generate_id() {
    cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 32 | head -n 1
}

add_calendar() {
    read -p "Введите секретную ссылку Яндекс.Календаря (.ics): " yandex_url
    if [[ -z "$yandex_url" ]]; then return; fi
    
    read -p "Введите название календаря (напр. Работа): " cal_name
    if [[ -z "$cal_name" ]]; then cal_name="Yandex Calendar"; fi

    public_ip=$(curl -s -4 api.ipify.org --connect-timeout 3 2>/dev/null || curl -s -4 ifconfig.me --connect-timeout 3 2>/dev/null)
    if [[ -n "$public_ip" && "$public_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        base_url="http://$public_ip:8085"
    else
        read -p "Укажите домен или базовый URL (напр. http://example.com:8085): " base_url
    fi
    base_url=$(echo "$base_url" | sed 's:/*$::')
    if [[ -z "$base_url" ]]; then return; fi

    cal_id=$(generate_id)
    
    python3 <<EOF
import json
try:
    with open('$CONFIG_FILE', 'r') as f: data = json.load(f)
except:
    data = {}
data['$cal_id'] = {'url': '$yandex_url', 'name': '$cal_name'}
with open('$CONFIG_FILE', 'w') as f: json.dump(data, f, indent=4)
EOF
    
    echo -e "\\nКалендарь '$cal_name' успешно добавлен!"
    echo -e "========================================================="
    echo -e "ВНИМАНИЕ: Эта ссылка выводится только один раз!"
    echo -e "Обязательно сохраните её себе:"
    echo -e "========================================================="
    echo -e "$base_url/cal/$cal_id.ics\\n"
}

list_calendars() {
    python3 <<EOF
import json
try:
    with open('$CONFIG_FILE', 'r') as f: data = json.load(f)
    if not data: print('Нет календарей.')
    else:
        for idx, (k, v) in enumerate(data.items(), 1):
            if isinstance(v, dict): print(f"{idx}. {v.get('name')}")
            else: print(f"{idx}. (Без имени)")
except Exception as e:
    print(f'Ошибка: {e}')
EOF
}

delete_calendar() {
    list_calendars
    read -p "Введите номер календаря для удаления: " del_idx
    if [[ -z "$del_idx" ]]; then return; fi
    python3 <<EOF
import json
try:
    with open('$CONFIG_FILE', 'r') as f: data = json.load(f)
    if not data: exit()
    
    keys = list(data.keys())
    try:
        idx = int('$del_idx') - 1
        if 0 <= idx < len(keys):
            del data[keys[idx]]
            with open('$CONFIG_FILE', 'w') as f: json.dump(data, f, indent=4)
            print('Удалено.')
        else:
            print('Неверный номер.')
    except ValueError:
        print('Введите число.')
except: pass
EOF
}

if [[ "$1" == "install" ]]; then
    install
    exit 0
fi

while true; do
    echo -e "\\n1. Добавить календарь\\n2. Список\\n3. Удалить\\n4. Перезапуск сервера\\n0. Выход"
    read -p "Выбор: " choice
    case $choice in
        1) add_calendar ;; 2) list_calendars ;; 3) delete_calendar ;; 4) $DOCKER_COMPOSE_CMD restart ;; 0) exit 0 ;;
    esac
done
